{
  "name": "@croco/billing-polar",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/billing-polar"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run --exclude src/tests/PolarLiveSmoke.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:live": "vitest run src/tests/PolarLiveSmoke.spec.ts",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/billing-core": "workspace:*",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/events-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-module": "workspace:*",
    "@croco/metering-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/telemetry-api": "workspace:*",
    "@polar-sh/sdk": "^0.49.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@croco/protocols-core": "workspace:*",
    "@croco/testing": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.8"
  }
}
