{
  "name": "@croco/metering-drizzle",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/metering-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "migrate:up": "migrate up",
    "migrate:status": "migrate status",
    "migrate:down": "migrate down",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/metering-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/tx-core": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@croco/migration-runner": "workspace:*",
    "@croco/testing": "workspace:*",
    "@croco/tx-drizzle": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "ulid": "^3.0.2",
    "vitest": "4.1.8"
  }
}
