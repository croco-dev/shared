{
  "name": "@croco/cli",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/cli"
  },
  "bin": {
    "croco": "./dist/bin/croco.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bin/croco.js"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./ops": {
        "types": "./dist/ops.d.ts",
        "import": "./dist/ops.js"
      },
      "./jobs": {
        "types": "./dist/jobs.d.ts",
        "import": "./dist/jobs.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"src/tests/integration/**\"",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:integration": "vitest run src/tests/integration/CliCommandIntegration.spec.ts src/tests/integration/e2e.spec.ts src/tests/integration/jobs-e2e.spec.ts",
    "test:e2e": "vitest run src/tests/integration",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@croco/architecture-policy": "workspace:*",
    "@croco/desktop-codegen": "workspace:*",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-routes": "workspace:*",
    "@croco/migration-runner": "workspace:*",
    "@croco/openapi-spec": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/protocols-desktop": "workspace:*",
    "@croco/rpc-codegen": "workspace:*",
    "@croco/testing": "workspace:*",
    "citty": "^0.1.6",
    "ts-morph": "^24.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@croco/execution-core": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typedi": "0.10.0",
    "vitest": "^4.1.8"
  }
}
