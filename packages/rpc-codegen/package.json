{
  "name": "@croco/rpc-codegen",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/rpc-codegen"
  },
  "bin": {
    "croco-rpc-codegen": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.cjs",
    "./dist/cli.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude src/tests/e2e.spec.ts --exclude src/tests/real-app.e2e.spec.ts --exclude src/tests/PublishedCli.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:integration": "vitest run src/tests/e2e.spec.ts src/tests/real-app.e2e.spec.ts",
    "test:published": "vitest run src/tests/PublishedCli.spec.ts",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/presentation-preset": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/protocol-codegen": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/events-core": "workspace:*",
    "@croco/framework-config": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/framework-logger": "workspace:*",
    "@croco/health-core": "workspace:*",
    "@croco/openapi-spec": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "@croco/ratelimit-core": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "ts-morph": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "4.1.8",
    "zod": "^3.23.8"
  }
}
