{
  "name": "create-croco-app",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/create-croco-app"
  },
  "bin": {
    "create-croco-app": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./programmatic": {
        "types": "./dist/programmatic.d.ts",
        "import": "./dist/programmatic.js"
      },
      "./generator": {
        "types": "./dist/generator.d.ts",
        "import": "./dist/generator.js"
      },
      "./dist/verification.js": {
        "types": "./dist/verification.d.ts",
        "import": "./dist/verification.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint .",
    "smoke:generated-apps": "node --experimental-strip-types ../../scripts/create-croco-app-generated-smoke.mts",
    "test": "vitest run --exclude src/tests/e2e-advanced.spec.ts --exclude src/tests/e2e-generation.spec.ts --exclude src/tests/e2e-vite-spa.spec.ts --exclude src/tests/PublishedCli.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:integration": "vitest run src/tests/e2e-advanced.spec.ts src/tests/e2e-generation.spec.ts src/tests/e2e-vite-spa.spec.ts",
    "test:published": "vitest run src/tests/PublishedCli.spec.ts",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "@croco/problems-core": "workspace:*",
    "@croco/telemetry-sdk-node": "workspace:*",
    "commander": "^12.0.0",
    "fs-extra": "^11.0.0",
    "handlebars": "^4.7.9",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/tenant-core": "workspace:*",
    "@types/fs-extra": "^11.0.0",
    "@types/handlebars": "^4.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "4.1.8",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "crocoGeneratedAppDependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
