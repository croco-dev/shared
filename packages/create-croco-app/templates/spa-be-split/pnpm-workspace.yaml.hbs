packages:
  - "apps/**/*"
  - "libs/**/*"

overrides:
  postcss: 8.5.18
  sharp: 0.35.4

patchedDependencies:
  tsup@8.5.1: patches/tsup@8.5.1.patch

allowBuilds:
  "@apollo/protobufjs": true
  esbuild: true
  lefthook: true
  msw: true
  protobufjs: true
  sharp: true
  unrs-resolver: true

onlyBuiltDependencies:
  - "@apollo/protobufjs"
  - esbuild
  - lefthook
  - msw
  - protobufjs
  - sharp
  - unrs-resolver
