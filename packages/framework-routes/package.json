{
  "name": "@croco/framework-routes",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/framework-routes"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/compiler.js",
    "./dist/compiler.mjs",
    "./dist/index.js",
    "./dist/index.mjs",
    "./dist/metadata-reader.js",
    "./dist/metadata-reader.mjs"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-routes.js",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "@croco/protocols-rest": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  }
}
