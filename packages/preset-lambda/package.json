{
  "name": "@croco/preset-lambda",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/preset-lambda"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./entry": {
        "types": "./dist/handler.d.ts",
        "import": "./dist/handler.mjs",
        "require": "./dist/handler.js"
      },
      "./handler": {
        "types": "./dist/handler.d.ts",
        "import": "./dist/handler.mjs",
        "require": "./dist/handler.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/framework-preset": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  }
}
