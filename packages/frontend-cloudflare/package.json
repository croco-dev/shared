{
  "name": "@croco/frontend-cloudflare",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/frontend-cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/worker.js",
  "types": "./dist/worker.d.ts",
  "exports": {
    ".": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "publishConfig": {
    "main": "./dist/worker.js",
    "types": "./dist/worker.d.ts",
    "exports": {
      ".": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.js",
        "require": "./dist/worker.cjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/meta-vite": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@croco/frontend-react": "workspace:*",
    "vitest": "^4.1.8"
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  }
}
