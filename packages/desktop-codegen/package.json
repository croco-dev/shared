{
  "name": "@croco/desktop-codegen",
  "version": "0.1.0",
  "description": "Deterministic desktop bridge and renderer client generation for Croco applications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/desktop-codegen"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*",
    "@croco/protocols-desktop": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "^3.23.8"
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts"
    ]
  }
}
