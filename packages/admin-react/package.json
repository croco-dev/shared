{
  "name": "@croco/admin-react",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/admin-react"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts --external react --external react-dom --external @croco/admin-core --external @croco/admin-ops --external @croco/billing-core --external @croco/entitlements-core --external @croco/impersonation-core --external @croco/lifecycle-core --external @croco/metering-core --external @croco/pagination-core --external @croco/problems-core --external @croco/search-core --external @croco/tenant-core",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/admin-core": "workspace:*",
    "@croco/admin-ops": "workspace:*",
    "@croco/billing-core": "workspace:*",
    "@croco/entitlements-core": "workspace:*",
    "@croco/impersonation-core": "workspace:*",
    "@croco/lifecycle-core": "workspace:*",
    "@croco/metering-core": "workspace:*",
    "@croco/pagination-core": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/search-core": "workspace:*",
    "@croco/tenant-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "vitest": {
    "include": [
      "src/**/*.spec.ts",
      "src/**/*.spec.tsx"
    ]
  }
}
