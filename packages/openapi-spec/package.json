{
  "name": "@croco/openapi-spec",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/openapi-spec"
  },
  "bin": {
    "croco-openapi-spec": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/cli.js",
    "./dist/cli.mjs",
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:watch": "vitest",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@croco/problems-core": "workspace:*",
    "@croco/protocol-codegen": "workspace:*",
    "@croco/protocols-core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@croco/protocols-rest": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "@redocly/cli": "^2.30.3",
    "orval": "8.24.0",
    "reflect-metadata": "^0.2.2",
    "typedi": "0.10.0",
    "vitest": "4.1.8"
  },
  "vitest": {
    "include": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts"
    ]
  }
}
