{
  "name": "@croco/entitlements-drizzle",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/entitlements-drizzle"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run --exclude src/tests/LegacyEntitlementRules.postgres.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:live": "vitest run src/tests/LegacyEntitlementRules.postgres.spec.ts",
    "test:postgres": "vitest run src/tests/LegacyEntitlementRules.postgres.spec.ts",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/billing-core": "workspace:*",
    "@croco/entitlements-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/tx-drizzle": "workspace:*"
  },
  "devDependencies": {
    "@croco/problems-core": "workspace:*",
    "@croco/testing": "workspace:*",
    "@types/pg": "8.20.0",
    "drizzle-orm": "catalog:",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
