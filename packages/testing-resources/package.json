{
  "name": "@croco/testing-resources",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/testing-resources"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run --exclude src/tests/RealResources.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:live": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/RealResources.spec.ts",
    "test:real": "CROCO_TEST_REAL_RESOURCES=1 vitest run src/tests/RealResources.spec.ts",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*",
    "@croco/testing": "workspace:*",
    "@types/ioredis": "4.28.10",
    "@types/pg": "8.20.0"
  },
  "devDependencies": {
    "@croco/auth-clerk": "workspace:*",
    "@croco/auth-core": "workspace:*",
    "@croco/diagnostics-core": "workspace:*",
    "@croco/events-core": "workspace:*",
    "@croco/events-tx": "workspace:*",
    "@croco/framework-module": "workspace:*",
    "@croco/telemetry-sdk-node": "workspace:*",
    "@croco/transports-http": "workspace:*",
    "@croco/tx-core": "workspace:*",
    "@croco/tx-drizzle": "workspace:*",
    "drizzle-orm": "catalog:",
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "testcontainers": "12.0.4",
    "tsup": "8.5.1",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "ioredis": "5.11.1",
    "pg": "8.22.0",
    "testcontainers": "12.0.4"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "testcontainers": {
      "optional": true
    }
  }
}
