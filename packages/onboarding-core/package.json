{
  "name": "@croco/onboarding-core",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/onboarding-core"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.mjs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --minify --clean --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/analytics-core": "workspace:*",
    "@croco/framework-context": "workspace:*",
    "@croco/problems-core": "workspace:*"
  },
  "devDependencies": {
    "reflect-metadata": "^0.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "4.1.8"
  }
}
