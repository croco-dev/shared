{
  "name": "@croco/migration-runner",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/croco-dev/framework.git",
    "directory": "packages/migration-runner"
  },
  "bin": {
    "migrate": "./src/cli.ts"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": [
    "./dist/cli.js",
    "./dist/cli.mjs"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "bin": {
      "migrate": "./dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "import": "./dist/cli.mjs",
        "require": "./dist/cli.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --minify --clean --dts",
    "lint": "oxlint .",
    "test": "vitest run --exclude src/tests/MigrationStatusPostgres.spec.ts --exclude src/tests/PublishedCli.spec.ts",
    "test:evidence": "pnpm run test --maxWorkers=1 --reporter=json --outputFile=.turbo/croco-test-evidence.json",
    "test:live": "vitest run src/tests/MigrationStatusPostgres.spec.ts",
    "test:published": "vitest run src/tests/PublishedCli.spec.ts",
    "typecheck": "tsc --noEmit",
    "docs:api:model": "node --experimental-strip-types ../docs/scripts/generate-package-api-model.mts"
  },
  "dependencies": {
    "@croco/problems-core": "workspace:*",
    "commander": "^11.0.0",
    "drizzle-orm": "catalog:",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22",
    "@types/pg": "^8.15.6",
    "better-sqlite3": "^11.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.8"
  },
  "peerDependencies": {
    "drizzle-orm": "catalog:"
  }
}
