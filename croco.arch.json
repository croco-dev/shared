{
  "schemaVersion": "croco.architecture-policy/v1",
  "policyName": "croco-framework",
  "packageRoots": ["packages"],
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/src/**/*.mts",
    "packages/*/src/**/*.cts"
  ],
  "ignore": [
    "packages/*/src/**/__tests__/**",
    "packages/*/src/**/tests/**",
    "packages/*/src/**/*.spec.ts",
    "packages/*/src/**/*.test.ts"
  ],
  "packageGroups": {
    "kernel": {
      "packages": [
        "@croco/diagnostics-core",
        "@croco/framework-config",
        "@croco/framework-context",
        "@croco/framework-logger",
        "@croco/framework-module",
        "@croco/problems-core"
      ]
    },
    "contracts": {
      "packages": [
        "@croco/access-core",
        "@croco/admin-core",
        "@croco/admin-ops",
        "@croco/analytics-core",
        "@croco/audit-core",
        "@croco/auth-core",
        "@croco/batch-core",
        "@croco/billing-core",
        "@croco/cache-core",
        "@croco/credits-core",
        "@croco/customer-health-core",
        "@croco/dataloader-core",
        "@croco/engagement-core",
        "@croco/entitlements-core",
        "@croco/events-core",
        "@croco/execution-core",
        "@croco/features-core",
        "@croco/gid-core",
        "@croco/governance-core",
        "@croco/health-core",
        "@croco/idempotency-core",
        "@croco/impersonation-core",
        "@croco/invitation-core",
        "@croco/lifecycle-core",
        "@croco/llm-core",
        "@croco/membership-core",
        "@croco/metering-core",
        "@croco/metrics-core",
        "@croco/notifications-core",
        "@croco/onboarding-core",
        "@croco/outbox-core",
        "@croco/pagination-core",
        "@croco/protocols-core",
        "@croco/protocols-rest",
        "@croco/ratelimit-core",
        "@croco/repository-core",
        "@croco/retry-core",
        "@croco/search-core",
        "@croco/storage-core",
        "@croco/tasks-core",
        "@croco/telemetry-api",
        "@croco/tenant-core",
        "@croco/triggers-core",
        "@croco/tx-core",
        "@croco/webhooks-core",
        "@croco/workflow-core"
      ],
      "paths": ["packages/protocols-desktop"]
    },
    "plugins": {
      "packages": [
        "@croco/access-drizzle",
        "@croco/admin-react",
        "@croco/analytics-posthog",
        "@croco/audit-drizzle",
        "@croco/auth-better-auth",
        "@croco/auth-clerk",
        "@croco/auth-drizzle",
        "@croco/batch-qstash",
        "@croco/billing-polar",
        "@croco/credits-drizzle",
        "@croco/customer-health-drizzle",
        "@croco/engagement-drizzle",
        "@croco/entitlements-drizzle",
        "@croco/events-inmemory",
        "@croco/events-tx",
        "@croco/execution-drizzle",
        "@croco/features-posthog",
        "@croco/framework-routes",
        "@croco/frontend-cloudflare",
        "@croco/frontend-problems",
        "@croco/frontend-react",
        "@croco/integrations-posthog",
        "@croco/invitation-drizzle",
        "@croco/llm-metering",
        "@croco/llm-openai",
        "@croco/membership-drizzle",
        "@croco/metering-drizzle",
        "@croco/metering-upstash",
        "@croco/metrics-billing",
        "@croco/notifications-react-email",
        "@croco/notifications-resend",
        "@croco/onboarding-drizzle",
        "@croco/preset-cloudflare",
        "@croco/preset-lambda",
        "@croco/preset-node",
        "@croco/protocols-graphql",
        "@croco/protocols-trpc",
        "@croco/ratelimit-upstash",
        "@croco/search-drizzle",
        "@croco/search-meilisearch",
        "@croco/storage-cloudflare",
        "@croco/storage-cloudinary",
        "@croco/storage-r2",
        "@croco/tasks-qstash",
        "@croco/telemetry-sdk-node",
        "@croco/transports-cloudflare-workers",
        "@croco/transports-graphql",
        "@croco/transports-http",
        "@croco/triggers-qstash",
        "@croco/tx-drizzle",
        "@croco/ui-astryx"
      ]
    },
    "profiles": {
      "packages": ["@croco/presentation-preset"]
    },
    "tooling": {
      "packages": [
        "@croco/admin-generated",
        "@croco/architecture-policy",
        "@croco/cli",
        "create-croco-app",
        "@croco/desktop-codegen",
        "@croco/esbuild-plugin",
        "@croco/framework-preset",
        "@croco/frontend-vite",
        "@croco/meta-vite",
        "@croco/migration-runner",
        "@croco/openapi-spec",
        "@croco/protocol-codegen",
        "@croco/rpc-codegen",
        "@croco/testing",
        "@croco/testing-resources"
      ]
    },
    "application": {
      "packages": []
    },
    "desktop-contracts": {
      "description": "Browser-safe desktop contract declarations and schema compiler inputs.",
      "packages": ["@croco/protocols-desktop"]
    }
  },
  "rules": {
    "forbiddenImports": [
      {
        "id": "framework-provider-package-boundary",
        "description": "Canonical contract and kernel boundaries exclude concrete Plugins.",
        "from": {
          "groups": ["kernel", "contracts", "desktop-contracts"]
        },
        "to": {
          "groups": ["plugins"]
        },
        "message": "Kernel and Contracts cannot import concrete Plugins.",
        "recovery": "Move provider/runtime implementation code behind an adapter package and keep the framework/core package on an explicit contract."
      },
      {
        "id": "framework-provider-sdk-boundary",
        "description": "Framework and core packages must not depend on concrete provider/runtime SDKs.",
        "from": {
          "groups": ["kernel", "contracts", "desktop-contracts"]
        },
        "to": {
          "specifiers": [
            "@clerk/*",
            "@hono/node-server",
            "@polar-sh/*",
            "@upstash/*",
            "cloudinary",
            "cloudinary/*",
            "drizzle-orm",
            "drizzle-orm/*",
            "hono",
            "hono/*",
            "ioredis",
            "ioredis/*"
          ]
        },
        "message": "Framework/core packages cannot import provider or runtime implementation SDKs.",
        "recovery": "Move provider/runtime implementation code behind an adapter package and keep the framework/core package on an explicit contract."
      },
      {
        "id": "desktop-contract-runtime-imports",
        "description": "Desktop protocol contracts must remain independent of Electron, Node, and Electron transport runtimes.",
        "from": {
          "groups": ["desktop-contracts"]
        },
        "to": {
          "specifiers": [
            "electron",
            "electron/*",
            "node:*",
            "@croco/transports-electron",
            "@croco/transports-electron/*"
          ]
        },
        "appliesTo": ["source"],
        "message": "Desktop protocol contracts cannot import Electron, Node runtime APIs, or Electron transports.",
        "recovery": "Move runtime integration behind an Electron transport package and keep protocols-desktop browser-safe."
      },
      {
        "id": "desktop-contract-application-imports",
        "description": "Desktop protocol contracts must not import application bootstrap packages.",
        "from": {
          "groups": ["desktop-contracts"]
        },
        "to": {
          "groups": ["application", "tooling"]
        },
        "appliesTo": ["source"],
        "message": "Desktop protocol contracts cannot import application bootstrap packages.",
        "recovery": "Keep application composition outside protocols-desktop and depend only on declared contract packages."
      }
    ],
    "allowedGroupImports": [
      {
        "id": "desktop-contract-package-dependencies",
        "fromGroups": ["desktop-contracts"],
        "allowGroups": [],
        "allowSpecifiers": ["vitest", "zod"],
        "allowSameGroup": false,
        "allowExternal": false,
        "appliesTo": ["package-manifest"],
        "message": "Desktop protocol package manifests may depend only on contract libraries and declared test/schema tooling.",
        "recovery": "Keep protocols-desktop dependencies limited to @croco/problems-core, @croco/protocols-core, vitest, and zod.",
        "allowPackages": ["@croco/problems-core", "@croco/protocols-core"]
      }
    ],
    "publicEntrypoints": {
      "id": "croco-public-entrypoints",
      "description": "Production source imports between Croco packages must use declared package exports instead of src/dist internals.",
      "includePackages": ["@croco/*"],
      "ignoreImports": [
        {
          "paths": [
            "packages/*/src/**/__tests__/**",
            "packages/*/src/**/tests/**",
            "packages/*/src/**/*.spec.ts",
            "packages/*/src/**/*.test.ts"
          ],
          "specifiers": ["@croco/*/src/**"]
        }
      ],
      "message": "Croco packages must import declared public entrypoints instead of private package internals.",
      "recovery": "Export the needed surface from the target package or move the test-only alias behind an explicit test/config ignore."
    }
  }
}
